        "format": "prettier --write \"assets/**/*.{js,css,scss}\" \".eslintrc.js\" \"webpack.config.js\"",
        "lint": "eslint --fix --ext .js assets/js webpack.config.js",
        "start": "webpack serve",
        "test": "echo \"Error: no test specified yet\" && exit 1",
        "watch": "webpack --config webpack.config.js --watch --mode=development"
    },
    "repository": {
